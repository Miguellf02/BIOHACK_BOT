# =============================================================================
# .gitignore — Deep-Biohacking Tracker
# =============================================================================

# ── Credenciales y configuración sensible ──────────────────────────────────
.env
.env.*
!.env.example          # El ejemplo SÍ se commitea (sin valores reales)
*.pem
*.key
secrets/

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ── Entornos virtuales ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env/

# ── Distribución y empaquetado ──────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
.eggs/
wheels/

# ── Testing y cobertura ─────────────────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.xml

# ── Herramientas de calidad de código ───────────────────────────────────────
.mypy_cache/
.ruff_cache/
.pyright/

# ── IDEs ─────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Docker ───────────────────────────────────────────────────────────────────
# No ignorar Dockerfile ni docker-compose.yml (son parte del proyecto)
docker-compose.override.yml

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb
